# PostgreSQL
POSTGRES_DB=exoscan
POSTGRES_USER=exoscan
POSTGRES_PASSWORD=changeme_strong_password

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# NVD API key (optional — raises rate limit from 5 to 50 req/30s)
# Register at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Frontend origin for CORS (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Email address that is automatically promoted to admin on register/login.
# Leave empty to manage admin status via direct DB update.
ADMIN_EMAIL=

# Docker volume names — must match the name: fields in docker-compose.yml
# Only override if you renamed the volumes
NUCLEI_TEMPLATES_VOLUME=exoscan_nuclei_templates_vol
SCREENSHOTS_VOLUME=exoscan_screenshots_vol

# Pre-built image registry (Docker Hub)
# Set DOCKERHUB_USERNAME to your Docker Hub username.
# Images are published by the CI workflow at:
#   docker.io/<DOCKERHUB_USERNAME>/exoscan-be
#   docker.io/<DOCKERHUB_USERNAME>/exoscan-fe
#
# Deployment (pull pre-built images):
#   docker compose pull && docker compose up -d
#
# Local development (build from source):
#   docker compose up --build
DOCKERHUB_USERNAME=your-dockerhub-username
TAG=latest
